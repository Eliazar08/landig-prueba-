---
const reasons = [
  { img: '/assets/reason-1.webp', title: 'Experiencia', text: 'Años de trabajo con MercadoLibre.' },
  { img: '/assets/reason-2.webp', title: 'Velocidad', text: 'Entregas el mismo día.' },
  { img: '/assets/reason-3.webp', title: 'Cobertura', text: 'CABA y Gran Buenos Aires.' },
  { img: '/assets/reason-4.webp', title: 'Soporte', text: 'Atención personalizada por WhatsApp.' },
];
---
<section id="menu2" class="bg-brandSoft/40 py-16">
  <h2 class="mb-12 text-center text-3xl font-bold text-gray-900">¿Por qué nosotros?</h2>
  <div class="mx-auto max-w-7xl grid grid-cols-1 gap-8 px-4 sm:grid-cols-2 lg:grid-cols-4">
    {reasons.map(reason => (
      <div class="rounded-2xl bg-white p-6 text-center shadow">
        <img src={reason.img} alt="" class="mx-auto mb-4 h-24 w-24" />
        <h3 class="mb-2 text-xl font-semibold text-gray-900">{reason.title}</h3>
        <p class="text-gray-700">{reason.text}</p>
      </div>
    ))}
  </div>
</section>
