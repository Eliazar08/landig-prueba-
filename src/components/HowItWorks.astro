---
const steps = [
  { img: '/assets/step-1.webp', title: 'Coordinás', text: 'Nos escribís y coordinamos el retiro.' },
  { img: '/assets/step-2.webp', title: 'Retiramos', text: 'Buscamos tu paquete cuando lo necesites.' },
  { img: '/assets/step-3.webp', title: 'Entregamos', text: 'Lo llevamos rápido a tu comprador.' },
];
---
<section id="menu1" class="py-16">
  <h2 class="mb-12 text-center text-3xl font-bold text-gray-900">Cómo funciona nuestro servicio</h2>
  <div class="mx-auto max-w-7xl grid grid-cols-1 gap-8 px-4 sm:grid-cols-2 lg:grid-cols-3">
    {steps.map(step => (
      <div class="rounded-2xl bg-white p-6 text-center shadow">
        <img src={step.img} alt="" class="mx-auto mb-4 h-24 w-24" />
        <h3 class="mb-2 text-xl font-semibold text-gray-900">{step.title}</h3>
        <p class="text-gray-700">{step.text}</p>
      </div>
    ))}
  </div>
</section>
